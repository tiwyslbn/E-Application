<%- include('../partials/header') %>
<div class="container"><div class="auth-shell">
  <div class="auth-art"><h2>Selamat datang kembali</h2><p>Masuk untuk melihat e-tiket, nomor antrian, dan riwayat pesananmu.</p><%- include('../partials/auth_photos') %></div>
  <div class="auth-form">
    <h1>Masuk</h1><p class="text-muted">Medan Smart Tourism</p>
    <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-danger py-2 small" role="alert"><%= error %></div><% } %>
    <form method="post" action="/login" novalidate>
      <%- csrfField %>
      <div class="mb-3"><label class="form-label" for="email">Email</label><input type="email" id="email" name="email" class="form-control" value="<%= email %>" autocomplete="username" required autofocus></div>
      <div class="mb-3"><label class="form-label" for="password">Password</label><input type="password" id="password" name="password" class="form-control" autocomplete="current-password" required></div>
      <button class="btn btn-green btn-lg w-100 mb-3">Masuk</button>
    </form>
    <div class="text-center small">Belum punya akun? <a href="/register">Daftar sebagai pengunjung</a></div>
  </div>
</div></div>
<%- include('../partials/footer') %>
