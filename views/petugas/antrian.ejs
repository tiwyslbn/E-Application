<%- include('../partials/header') %>
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
    <div class="page-head mb-0"><div class="ph-ico"><i class="bi bi-hourglass-split"></i></div><div class="ph-t"><h1>Manajemen antrian</h1><p><%= U.tanggal(today) %></p></div></div>
    <form method="get" class="d-flex gap-2"><select name="dest" class="form-select" aria-label="Pilih destinasi" onchange="this.form.submit()"><% dests.forEach(d => { %><option value="<%= d.id %>" <%= d.id === dest.id ? 'selected' : '' %>><%= d.name %></option><% }) %></select></form>
  </div>
  <div class="row g-3 mb-4">
    <div class="col-md-5"><div class="panel text-center"><div class="text-muted small">Sedang dilayani</div><div class="queue-big" style="font-size:3rem"><%= servingLabel || '---' %></div>
      <form method="post" action="/petugas/antrian/panggil" class="mt-3"><%- csrfField %><input type="hidden" name="dest" value="<%= dest.id %>"><button class="btn btn-gold btn-lg w-100"><i class="bi bi-megaphone me-1"></i>Panggil Berikutnya</button></form></div></div>
    <div class="col-md-7"><div class="panel p-0 overflow-hidden"><div class="table-responsive" style="max-height:340px"><table class="table align-middle mb-0">
      <thead><tr><th>No.</th><th>Pengunjung</th><th>Sesi</th><th>Orang</th><th>Status</th><th></th></tr></thead>
      <tbody><% list.forEach(q => { %><tr><td class="fw-bold"><%= B.queueLabel(dest.code, q.queue_number) %></td><td><%= q.visitor %></td><td class="small"><%= q.visit_slot %></td><td><%= q.persons %></td>
        <td><span class="status-pill pill-<%= q.status %>"><%= {waiting:'Menunggu', called:'Dipanggil', done:'Selesai', skipped:'Dilewati'}[q.status] %></span></td>
        <td class="text-end"><% if (q.status === 'waiting' || q.status === 'called') { %><form method="post" action="/petugas/antrian/<%= q.id %>/lewati" class="m-0"><%- csrfField %><button class="btn btn-sm btn-outline-secondary">Lewati</button></form><% } %></td></tr><% }) %>
      <% if (!list.length) { %><tr><td colspan="6" class="text-center text-muted py-4">Belum ada antrian hari ini.</td></tr><% } %></tbody></table></div></div></div>
  </div>
</div>
<%- include('../partials/footer') %>
